---
import { CircleChevronDown } from "lucide-astro";

interface Props {
  lang: "ja" | "en";
}

const { lang } = Astro.props;

const text = {
  ja: {
    name: "TAHO ITO",
    category: "Full Stack Developer ・ UI Designer ・ Creator",
    scroll: "SCROLL",
  },
  en: {
    name: "TAHO ITO",
    category: "Full Stack Developer ・ UI Designer ・ Creator",
    scroll: "SCROLL",
  },
};

const content = text[lang];
---

<section
  id="home"
  class="relative mt-16 flex min-h-[calc(100dvh-4rem)] w-full items-center justify-center overflow-hidden bg-[#F9DDE5] px-5 py-20"
>
  <!-- 左下の曲線 -->
  <div
    class="pointer-events-none absolute -bottom-28 -left-24 h-72 w-72 rounded-full border-[3px] border-[#EF7588]/25"
  ></div>

  <!-- 右上の曲線 -->
  <div
    class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full border-[3px] border-[#EF7588]/25"
  ></div>

  <!-- 左の小さな星 -->
  <span
    class="pointer-events-none absolute left-[10%] top-[32%] text-3xl text-[#F4C95D]"
    aria-hidden="true"
  >
    ✦
  </span>

  <!-- 右の小さな星 -->
  <span
    class="pointer-events-none absolute right-[11%] top-[36%] text-3xl text-[#EF7588]"
    aria-hidden="true"
  >
    ✦
  </span>

  <!-- メイン -->
  <div class="relative z-10 flex flex-col items-center text-center">
    <!-- タイトル周辺の星 -->
    <span
      class="pointer-events-none absolute -left-8 top-4 rotate-[-12deg] text-3xl text-[#F4C95D] sm:-left-14"
      aria-hidden="true"
    >
      ✧
    </span>

    <span
      class="pointer-events-none absolute -right-8 bottom-24 rotate-12 text-2xl text-[#EF7588] sm:-right-14"
      aria-hidden="true"
    >
      ✧
    </span>

    <!-- タイトル -->
    <h1
      class="font-title font-semibold leading-[0.62] tracking-[-0.075em]"
    >
      <span
        class="block rotate-[-3deg] text-[95px] text-[#2D2A2B] drop-shadow-[4px_5px_0_rgba(255,255,255,0.65)] sm:text-[120px] md:text-[155px]"
      >
        Port
      </span>

      <span
        class="ml-3 block rotate-[1deg] text-[88px] text-[#EF7588] drop-shadow-[4px_5px_0_rgba(255,255,255,0.65)] sm:text-[118px] md:text-[153px]"
      >
        folio
      </span>
    </h1>

    <!-- 名前 -->
    <div
      class="mt-8 rounded-full bg-white/80 px-8 py-2 text-sm font-semibold tracking-[0.12em] text-[#EF7588] shadow-sm"
    >
      {content.name}
    </div>

    <!-- 説明 -->
    <p
      class="mt-7 text-[11px] font-medium tracking-[0.12em] text-[#2D2A2B]/65 sm:text-[14px] sm:tracking-[0.14em]"
    >
      {content.category}
    </p>
  </div>

  <a
    href="#profile"
    class="group absolute bottom-30 left-1/2 z-20 flex -translate-x-1/2 flex-col items-center gap-3"
    aria-label="Scroll to profile section"
  >
    <CircleChevronDown
      size={65}
      strokeWidth={1.5}
      class="scroll-arrow text-[#EF7588] transition-all duration-300 group-hover:scale-110 group-hover:-translate-y-1"
    />
  </a>
</section>

<style>
  html {
    scroll-behavior: smooth;
  }

  @keyframes floatDown {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(6px);
    }
  }

  .scroll-arrow {
    animation: floatDown 1.8s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-arrow {
      animation: none;
    }
  }
</style>